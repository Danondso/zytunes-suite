# Copy to .env and fill in — docker-compose.yml reads this automatically.

# Absolute path to your music library on the host. Mounted read-only into
# the container at the same path; files are never copied or moved. (Same
# path, not /music: stem-cache keys hash the absolute track path, and
# matching the host path is what lets the server serve TUI-made splits.)
ZYTUNES_MUSIC_DIR=/path/to/your/music

# Shared secret required for Authorization: Bearer <token>. The server
# refuses to start on a LAN-reachable bind without one — generate with
# `openssl rand -hex 32` or similar.
ZYTUNES_STREAM_TOKEN=changeme

# Optional: host port to publish (container always listens on 9847).
# ZYTUNES_STREAM_PORT=9847

# Optional: host stem-cache directory, mounted so splits made with M in
# zytunes-tui are served to clients. Defaults to ~/.cache/zytunes/stems;
# set it ONLY if ~/.config/zytunes/config.toml overrides [stems] cache_dir
# — and then to that same path.
# ZYTUNES_STEMS_DIR=/path/to/your/stem-cache
